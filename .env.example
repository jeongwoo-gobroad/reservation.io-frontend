# 브라우저 API 진입점 (Vercel Proxy + Rewrite 경유)
NEXT_PUBLIC_API_BASE_URL=/api/backend

# 실제 API 백엔드 주소 (Cloud Run)
API_REWRITE_ORIGIN=https://reservation-api-881902730598.asia-northeast3.run.app

# 예약 생성/수정/취소 Vercel 함수가 사용할 Cloud Run 주소
BACKEND_API_BASE_URL=https://reservation-api-881902730598.asia-northeast3.run.app

# 예약 변이 요청이 Vercel Gateway를 거쳤는지 Cloud Run이 검증할 서버 전용 비밀값
RESERVATION_GATEWAY_SECRET=

# Vercel 함수가 Cloud Run 응답을 기다리는 최대 시간(ms)
BACKEND_FETCH_TIMEOUT_MS=15000

# 예약 대기실 설정
WAITING_ROOM_ENABLED=false
WAITING_ROOM_MAX_ACTIVE=80
WAITING_ROOM_LEASE_SECONDS=45
WAITING_ROOM_POLL_SECONDS=3

# Vercel Redis 기반 Sliding Window Counter의 1초당 (사용자, IP, API) 요청 제한 수
RATE_LIMIT_COUNTER=8
# Authorization 회전 우회를 막기 위한 1초당 (IP, API) 보조 제한 수
RATE_LIMIT_IP_COUNTER=40
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 카카오 OAuth 설정
NEXT_PUBLIC_KAKAO_REST_API_KEY=112cf9b3fdd6e7d07315f7643d48050c
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://reservation-io.vercel.app/oauth/kakao/callback

# 실용주의 컴퓨팅 연구소 URL
NEXT_PUBLIC_COMPANY_URL=https://practical-ps.synology.me/

# 시간 표시 기준 라벨
NEXT_PUBLIC_DISPLAY_TIMEZONE_LABEL=Seoul, KR
