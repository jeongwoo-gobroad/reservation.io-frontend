# API 백엔드 주소 (Cloud Run)
NEXT_PUBLIC_API_BASE_URL=https://reservation-api-xxxx.a.run.app

# 카카오 OAuth 설정
NEXT_PUBLIC_KAKAO_REST_API_KEY=your-kakao-rest-api-key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=https://your-domain.vercel.app/oauth/kakao/callback

# 실용주의 컴퓨팅 연구소 URL
NEXT_PUBLIC_COMPANY_URL=https://pragmatic-computing.com

# 시간 표시 기준 라벨
NEXT_PUBLIC_DISPLAY_TIMEZONE_LABEL=Seoul, KR
